{
  "name": "api-agendamentos",
  "version": "1.0.0",
  "description": "API simples de agendamentos (Service Pattern + PostgreSQL)",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node22 --minify --sourcemap=external --external:pg-native --outfile=dist/server.js",
    "start": "node dist/server.js",
    "test": "tsx --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
